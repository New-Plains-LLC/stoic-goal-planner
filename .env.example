# Stoic Planner — Worker Secrets
# Copy this file to .dev.vars for local development (never commit .dev.vars)

# Optional: Set to a strong random token to protect your deployment.
# Generate one with: openssl rand -hex 32
# Leave blank to run without authentication (not recommended for public deployments).
APP_TOKEN=

# Google Calendar OAuth (optional — only needed if you enable Google Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft/Outlook OAuth (optional — only needed if you enable Outlook Calendar sync)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Anthropic API (used for AI-powered stoic quotes)
ANTHROPIC_API_KEY=
